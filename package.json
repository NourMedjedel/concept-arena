{
  "name": "concept-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fictional luxury-beauty concept study with traceable findings and editable research exports.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8789",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8789",
    "test": "node --test tests/*.test.js",
    "samples": "node scripts/export-samples.mjs",
    "cache-ai": "node scripts/cache-ai.mjs",
    "format": "prettier --write web scripts tests vite.config.js package.json",
    "format:check": "prettier --check web scripts tests vite.config.js package.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "exceljs": "4.4.0",
    "pptxgenjs": "4.0.1",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "vite": "8.3.8"
  },
  "overrides": {
    "uuid": "11.1.1",
    "image-size": "2.1.0"
  },
  "license": "MIT"
}
